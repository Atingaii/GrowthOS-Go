# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=24.19.0
ARG NODE_ALPINE_VERSION=3.23
ARG NGINX_VERSION=1.28.0
ARG NGINX_ALPINE_VERSION=3.21

FROM node:${NODE_VERSION}-alpine${NODE_ALPINE_VERSION} AS builder

ARG PNPM_VERSION=10.13.1

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

WORKDIR /src

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY web/package.json web/pnpm-lock.yaml ./
RUN --mount=type=cache,id=growthos-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY web/ ./
RUN pnpm run build

FROM nginx:${NGINX_VERSION}-alpine${NGINX_ALPINE_VERSION} AS runtime

COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder --chown=101:101 /src/dist /usr/share/nginx/html

USER 101:101
EXPOSE 8080
STOPSIGNAL SIGQUIT

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
