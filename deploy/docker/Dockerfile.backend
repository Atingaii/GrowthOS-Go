# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.6
ARG ALPINE_VERSION=3.23

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS builder

ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=compose-dev
ARG GO_BUILD_PARALLELISM=1
ARG GO_BUILD_MAX_PROCS=2
ARG GO_BUILD_MEMORY_LIMIT=768MiB

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && go mod verify

COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    case "${GO_BUILD_PARALLELISM}" in \
      ''|*[!0-9]*) printf '%s\n' 'GO_BUILD_PARALLELISM must be a positive integer' >&2; exit 2 ;; \
    esac; \
    case "${GO_BUILD_MAX_PROCS}" in \
      ''|*[!0-9]*) printf '%s\n' 'GO_BUILD_MAX_PROCS must be a positive integer' >&2; exit 2 ;; \
    esac; \
    if [ "${GO_BUILD_PARALLELISM}" -eq 0 ] || [ "${GO_BUILD_MAX_PROCS}" -eq 0 ]; then \
      printf '%s\n' 'Go build concurrency values must be greater than zero' >&2; \
      exit 2; \
    fi; \
    GOMAXPROCS="${GO_BUILD_MAX_PROCS}" \
    GOMEMLIMIT="${GO_BUILD_MEMORY_LIMIT}" \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -p="${GO_BUILD_PARALLELISM}" -buildvcs=false -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/growth-api ./cmd/growth-api && \
    GOMAXPROCS="${GO_BUILD_MAX_PROCS}" \
    GOMEMLIMIT="${GO_BUILD_MEMORY_LIMIT}" \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -p="${GO_BUILD_PARALLELISM}" -buildvcs=false -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/growth-migrate ./cmd/growth-migrate && \
    GOMAXPROCS="${GO_BUILD_MAX_PROCS}" \
    GOMEMLIMIT="${GO_BUILD_MEMORY_LIMIT}" \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -p="${GO_BUILD_PARALLELISM}" -buildvcs=false -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/growth-identity-provision ./cmd/growth-identity-provision

FROM alpine:${ALPINE_VERSION} AS runtime

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 65532 growthos && \
    adduser -S -D -H -u 65532 -G growthos -s /sbin/nologin growthos

WORKDIR /app
USER 65532:65532

FROM runtime AS api

COPY --from=builder --chown=65532:65532 /out/growth-api /usr/local/bin/growth-api

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/growth-api"]

FROM runtime AS migrate

COPY --from=builder --chown=65532:65532 /out/growth-migrate /usr/local/bin/growth-migrate

ENTRYPOINT ["/usr/local/bin/growth-migrate"]
CMD ["up"]

FROM runtime AS identity-provision

COPY --from=builder --chown=65532:65532 /out/growth-identity-provision /usr/local/bin/growth-identity-provision

ENTRYPOINT ["/usr/local/bin/growth-identity-provision"]
