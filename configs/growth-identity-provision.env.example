# Public local-development settings for the one-shot Identity account creator.
# The database credential is file-backed; the enrollment password is supplied
# only through scripts/compose-identity-provision.sh and never through env.
GROWTHOS_ENVIRONMENT=development
GROWTHOS_LOG_LEVEL=info
GROWTHOS_LOG_FORMAT=json
GROWTHOS_MYSQL_ADDRESS=mysql:3306
GROWTHOS_MYSQL_DATABASE=growthos
GROWTHOS_MYSQL_TLS_MODE=disabled
GROWTHOS_MYSQL_CONNECT_TIMEOUT=3s
GROWTHOS_MYSQL_WRITE_TIMEOUT=5s
GROWTHOS_IDENTITY_PROVISIONER_MYSQL_USER=growthos_identity_provisioner
GROWTHOS_IDENTITY_PROVISIONER_MYSQL_PASSWORD_FILE=/run/secrets/mysql_identity_provisioner_password
GROWTHOS_IDENTITY_PROVISIONER_MYSQL_READ_TIMEOUT=5s
GROWTHOS_IDENTITY_PROVISIONER_MYSQL_PING_TIMEOUT=3s
GROWTHOS_IDENTITY_PROVISIONER_OPERATION_TIMEOUT=3s
