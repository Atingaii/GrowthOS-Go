# GrowthOS API process configuration. This file contains no secrets and is not
# loaded automatically; export it through the shell or container runtime.
# Environment: development, test, staging, or production.
GROWTHOS_ENVIRONMENT=development

GROWTHOS_HTTP_ADDRESS=:8080
GROWTHOS_HTTP_SHUTDOWN_TIMEOUT=5s
GROWTHOS_HTTP_READ_HEADER_TIMEOUT=5s
GROWTHOS_HTTP_READ_TIMEOUT=15s
GROWTHOS_HTTP_WRITE_TIMEOUT=30s
GROWTHOS_HTTP_IDLE_TIMEOUT=60s

# Development/test-only ephemeral Lottery route. It is intentionally disabled
# by default and staging/production reject startup when it is enabled.
GROWTHOS_LOTTERY_EPHEMERAL_SELECTION_ENABLED=false
GROWTHOS_LOTTERY_SELECTION_TIMEOUT=3s

# Optional cache-aside Strategy projection. MySQL remains authoritative. The
# base TTL may be shortened but cannot exceed 5m; physical TTL subtracts up to
# 10% jitter. The three cache budgets together must fit selection timeout.
GROWTHOS_LOTTERY_STRATEGY_CACHE_ENABLED=false
GROWTHOS_LOTTERY_STRATEGY_CACHE_TTL=5m
GROWTHOS_LOTTERY_STRATEGY_CACHE_LOOKUP_TIMEOUT=75ms
GROWTHOS_LOTTERY_STRATEGY_CACHE_WRITE_TIMEOUT=75ms
GROWTHOS_LOTTERY_STRATEGY_CACHE_FILL_TIMEOUT=2s

# Log level: debug, info, warn, or error. Format: json or text.
GROWTHOS_LOG_LEVEL=info
GROWTHOS_LOG_FORMAT=json

# MySQL endpoint and API connection settings. Staging and production must use
# verify_identity; GROWTHOS_MYSQL_TLS_CA_FILE is optional with that mode and
# must not be set while TLS is disabled.
GROWTHOS_MYSQL_ADDRESS=127.0.0.1:3306
GROWTHOS_MYSQL_DATABASE=growthos
GROWTHOS_MYSQL_TLS_MODE=disabled
# For verify_identity only: GROWTHOS_MYSQL_TLS_CA_FILE=/path/to/mysql-ca.pem
GROWTHOS_MYSQL_CONNECT_TIMEOUT=3s
GROWTHOS_MYSQL_READ_TIMEOUT=5s
GROWTHOS_MYSQL_WRITE_TIMEOUT=5s

# Least-privilege API account and bounded connection-pool settings.
GROWTHOS_MYSQL_USER=growthos_app
GROWTHOS_MYSQL_PING_TIMEOUT=3s
GROWTHOS_MYSQL_MAX_OPEN_CONNS=10
GROWTHOS_MYSQL_MAX_IDLE_CONNS=10
GROWTHOS_MYSQL_CONN_MAX_LIFETIME=3m
GROWTHOS_MYSQL_CONN_MAX_IDLE_TIME=1m

# Optional Redis accelerator connection. Enabling the Strategy cache requires
# exactly one of GROWTHOS_REDIS_PASSWORD or GROWTHOS_REDIS_PASSWORD_FILE.
# Staging/production cache deployments require verify_identity.
GROWTHOS_REDIS_ADDRESS=127.0.0.1:6379
GROWTHOS_REDIS_USERNAME=growthos_api
GROWTHOS_REDIS_DATABASE=0
GROWTHOS_REDIS_TLS_MODE=disabled
# For verify_identity only: GROWTHOS_REDIS_TLS_CA_FILE=/path/to/redis-ca.pem
GROWTHOS_REDIS_DIAL_TIMEOUT=250ms
GROWTHOS_REDIS_READ_TIMEOUT=75ms
GROWTHOS_REDIS_WRITE_TIMEOUT=75ms
GROWTHOS_REDIS_POOL_TIMEOUT=100ms
GROWTHOS_REDIS_POOL_SIZE=10
GROWTHOS_REDIS_MIN_IDLE_CONNS=0
GROWTHOS_REDIS_CONN_MAX_LIFETIME=15m
GROWTHOS_REDIS_CONN_MAX_IDLE_TIME=5m

# Separately privileged migration account and execution limits. Keep at least
# five seconds between each deadline: statement + 5s <= network read, and
# network read + 5s <= lock. The lock timeout must stay between 11s and 11m.
GROWTHOS_MYSQL_MIGRATION_USER=growthos_migrator
GROWTHOS_MYSQL_MIGRATION_READ_TIMEOUT=35s
GROWTHOS_MYSQL_MIGRATION_LOCK_TIMEOUT=40s
GROWTHOS_MYSQL_MIGRATION_STATEMENT_TIMEOUT=30s

# GROWTHOS_MYSQL_PASSWORD and GROWTHOS_MYSQL_MIGRATION_PASSWORD are required
# secrets; Redis needs one only when the Strategy cache is enabled. Inject
# secrets through the process environment or a secret manager; never assign a
# password in this tracked example file.
