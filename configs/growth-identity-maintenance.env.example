# Public local-development settings for one bounded Identity maintenance run.
# The process reuses only the runtime Identity database credential; it accepts
# no caller-controlled cutoff, batch size, loop, or retry policy.
GROWTHOS_ENVIRONMENT=development
GROWTHOS_LOG_LEVEL=info
GROWTHOS_LOG_FORMAT=json
GROWTHOS_MYSQL_ADDRESS=mysql:3306
GROWTHOS_MYSQL_DATABASE=growthos
GROWTHOS_MYSQL_TLS_MODE=disabled
GROWTHOS_MYSQL_CONNECT_TIMEOUT=3s
GROWTHOS_MYSQL_WRITE_TIMEOUT=5s
GROWTHOS_IDENTITY_MYSQL_USER=growthos_identity
GROWTHOS_IDENTITY_MYSQL_PASSWORD_FILE=/run/secrets/mysql_identity_password
GROWTHOS_IDENTITY_MAINTENANCE_MYSQL_READ_TIMEOUT=5s
GROWTHOS_IDENTITY_MAINTENANCE_MYSQL_PING_TIMEOUT=3s
GROWTHOS_IDENTITY_MAINTENANCE_OPERATION_TIMEOUT=3s
